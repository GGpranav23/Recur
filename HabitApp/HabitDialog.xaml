<Window x:Class="HabitApp.HabitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habit" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,4,24,24">
        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox"/>

        <TextBlock Text="Question (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="QuestionBox"/>
        <TextBlock Text="For example: Did you meditate for at least 10 minutes today?"
                   Style="{StaticResource Hint}"/>

        <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="YesNoRadio" Content="Yes or no" GroupName="Kind"
                         Foreground="{DynamicResource TextPrimary}"
                         Checked="Option_Changed"/>
            <RadioButton x:Name="NumericRadio" Content="Measurable (a number)" GroupName="Kind"
                         Foreground="{DynamicResource TextPrimary}"
                         Margin="20,0,0,0" Checked="Option_Changed"/>
        </StackPanel>

        <StackPanel x:Name="TargetPanel" Visibility="Collapsed">
            <TextBlock Text="Daily target" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="TargetTypeBox" Width="100" Padding="8,6">
                    <ComboBoxItem Content="At least"/>
                    <ComboBoxItem Content="At most"/>
                </ComboBox>
                <TextBox x:Name="TargetBox" Width="80" Margin="8,0,0,0"/>
                <TextBox x:Name="UnitBox" Width="150" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Amount, then unit. For example: at least 20 pages, or at most 2 cups. For 'at most' habits, log 0 on days you had none."/>
        </StackPanel>

        <TextBlock Text="How often" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="FrequencyBox" Width="170" Padding="8,6"
                      SelectionChanged="Option_Changed">
                <ComboBoxItem Content="Every day"/>
                <ComboBoxItem Content="Weekly"/>
                <ComboBoxItem Content="Monthly"/>
                <ComboBoxItem Content="Every few days"/>
            </ComboBox>
            <TextBox x:Name="FrequencyNumberBox" Width="56" Margin="8,0,0,0"
                     Visibility="Collapsed"/>
            <TextBlock x:Name="FrequencyHint" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <TextBlock Text="Reminder" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="ReminderCheck" Content="Remind me at" VerticalAlignment="Center"
                      Foreground="{DynamicResource TextPrimary}"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>
            <TextBox x:Name="ReminderBox" Width="80" Margin="8,0,0,0" IsEnabled="False"/>
            <TextBlock Text="for example 07:30 or 20:00" Margin="8,0,0,0"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextMuted}"/>
        </StackPanel>

        <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
        <ListBox x:Name="ColorList" BorderThickness="0" Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Width="36" Height="36" Background="Transparent" Cursor="Hand">
                                    <Ellipse x:Name="Ring" Width="32" Height="32"
                                             Stroke="{DynamicResource TextPrimary}"
                                             StrokeThickness="2" Visibility="Hidden"/>
                                    <Ellipse Width="22" Height="22" Fill="{Binding}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock Text="Notes about this habit (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DescriptionBox" Height="60" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>