<Window x:Class="HabitApp.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habit details" Width="820" Height="760"
        MinWidth="820" MaxWidth="820" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Name, question, schedule and description -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ColorDot" Width="16" Height="16"
                         VerticalAlignment="Top" Margin="0,11,0,0"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="NameText" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="QuestionText" FontSize="15" TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="SummaryText" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Grid>

            <!-- Overview tiles -->
            <UniformGrid Columns="3" Margin="0,8,0,0">
                <Border Style="{StaticResource Card}" Margin="0,12,8,0">
                    <StackPanel>
                        <TextBlock Text="Strength" Style="{StaticResource TileLabel}"/>
                        <TextBlock x:Name="StrengthValue" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,8,0">
                    <StackPanel>
                        <TextBlock Text="Change in the last month" Style="{StaticResource TileLabel}"/>
                        <TextBlock x:Name="MonthValue" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Change in the last year" Style="{StaticResource TileLabel}"/>
                        <TextBlock x:Name="YearValue" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,8,0">
                    <StackPanel>
                        <TextBlock Text="Current streak" Style="{StaticResource TileLabel}"/>
                        <TextBlock x:Name="CurrentValue" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,8,0">
                    <StackPanel>
                        <TextBlock Text="Best streak" Style="{StaticResource TileLabel}"/>
                        <TextBlock x:Name="BestValue" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="TotalLabel" Text="Days completed"
                                   Style="{StaticResource TileLabel}"/>
                        <TextBlock x:Name="TotalValue" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Strength over time -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="STRENGTH" Style="{StaticResource CardTitle}"/>
                        <ComboBox x:Name="ScorePeriod" Width="110" HorizontalAlignment="Right"
                                  SelectionChanged="Period_Changed">
                            <ComboBoxItem Content="Day"/>
                            <ComboBoxItem Content="Week"/>
                            <ComboBoxItem Content="Month"/>
                            <ComboBoxItem Content="Quarter"/>
                            <ComboBoxItem Content="Year"/>
                        </ComboBox>
                    </Grid>
                    <Canvas x:Name="ScoreCanvas" Width="690" Height="190"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Totals per period -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="HISTORY" Style="{StaticResource CardTitle}"/>
                        <ComboBox x:Name="HistoryPeriod" Width="110" HorizontalAlignment="Right"
                                  SelectionChanged="Period_Changed">
                            <ComboBoxItem Content="Day"/>
                            <ComboBoxItem Content="Week"/>
                            <ComboBoxItem Content="Month"/>
                            <ComboBoxItem Content="Quarter"/>
                            <ComboBoxItem Content="Year"/>
                        </ComboBox>
                    </Grid>
                    <Canvas x:Name="HistoryCanvas" Width="690" Height="190"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Calendar that can be edited -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="CALENDAR" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="CalendarRange" FontSize="12" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <Button Content="◀" Style="{StaticResource IconButton}"
                                    ToolTip="Earlier" Click="Earlier_Click"/>
                            <Button x:Name="LaterButton" Content="▶"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Later" Click="Later_Click"/>
                        </StackPanel>
                    </Grid>
                    <Canvas x:Name="HeatCanvas" Width="690" Height="182"
                            HorizontalAlignment="Left"/>
                    <TextBlock FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextMuted}"
                               Text="Click a day to change it. Right-click to skip it or add a note."/>
                </StackPanel>
            </Border>

            <!-- Longest streaks -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="BEST STREAKS" Style="{StaticResource CardTitle}"
                               Margin="0,0,0,12"/>
                    <StackPanel x:Name="StreakPanel"/>
                </StackPanel>
            </Border>

            <!-- Notes written on days -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="NOTES" Style="{StaticResource CardTitle}"
                               Margin="0,0,0,12"/>
                    <StackPanel x:Name="NotesPanel"/>
                </StackPanel>
            </Border>

            <!-- Which weekdays, month by month -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="FREQUENCY, LAST 12 MONTHS" Style="{StaticResource CardTitle}"
                               Margin="0,0,0,12"/>
                    <Canvas x:Name="FrequencyCanvas" Width="690" Height="178"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Overall weekday success -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="BY DAY OF THE WEEK" Style="{StaticResource CardTitle}"
                               Margin="0,0,0,12"/>
                    <Canvas x:Name="WeekdayCanvas" Width="690" Height="160"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>