<Window x:Class="HabitApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LightRadio" Content="Light" GroupName="Theme"
                                 Checked="Theme_Changed"/>
                    <RadioButton x:Name="DarkRadio" Content="Dark" GroupName="Theme"
                                 Margin="24,0,0,0" Checked="Theme_Changed"/>
                    <RadioButton x:Name="SystemRadio" Content="Match Windows" GroupName="Theme"
                                 Margin="24,0,0,0" Checked="Theme_Changed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="CALENDAR" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <TextBlock Text="First day of the week" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <ComboBox x:Name="WeekStartBox" Width="220" HorizontalAlignment="Right"
                              SelectionChanged="WeekStart_Changed">
                        <ComboBoxItem x:Name="WindowsWeekItem" Content="Windows setting"/>
                        <ComboBoxItem Content="Sunday"/>
                        <ComboBoxItem Content="Monday"/>
                        <ComboBoxItem Content="Saturday"/>
                    </ComboBox>
                </Grid>
                <TextBlock Text="Used by the calendar and charts on each habit's page."
                           FontSize="12" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="YOUR DATA" Style="{StaticResource SectionTitle}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                           Text="Your habits are stored only on this computer. Back up now and then, and use a backup to move your habits to another PC."/>
                <WrapPanel Margin="0,14,0,0">
                    <Button Content="Back up…" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,8" Click="Backup_Click"/>
                    <Button Content="Restore…" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Click="Restore_Click"/>
                    <Button Content="Export to Excel (CSV)" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Click="Export_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Button Content="Close" Style="{StaticResource SecondaryButton}" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,20,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>